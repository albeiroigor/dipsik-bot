# ------------------------- obligatorio -------------------------
# Token del bot de Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=

# Clave de la API de DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# ------------------------- opcional -------------------------
# Modelo de DeepSeek (deepseek-chat o deepseek-reasoner)
DEEPSEEK_MODEL=deepseek-chat

# Creatividad de las respuestas (0.0 = serio, 1.0 = creativo)
TEMPERATURA=0.8

# Cuántos mensajes de conversación recuerda por canal
MAX_HISTORIAL=24

# Búsqueda en internet para el modelo: "auto" (por defecto) o "desactivada"
BUSQUEDA_WEB=auto

# Canales donde el bot responde a todos los mensajes sin mención (separados por comas)
CANALES_LIBRES=

# Prefijo para los comandos de texto (también funcionan como comandos slash)
PREFIJO=!

# ID de tu servidor: los comandos slash se sincronizan solo ahí (aparecen al instante).
# Déjalo vacío para sincronizar globalmente (puede tardar hasta 1 hora en aparecer).
SERVIDOR_ID=

# ------------------------- consejo diario -------------------------
# Canal donde enviar el consejo diario (ID). También se puede configurar
# desde Discord con /consejo_diario HH:MM, que tiene prioridad.
CONSEJO_CANAL=

# Hora del consejo diario en formato HH:MM (ej. 09:00)
CONSEJO_HORA=

# Zona horaria para los consejos (ej. America/Mexico_City, Europe/Madrid).
# Vacío = hora local del servidor donde corre el bot.
ZONA_HORARIA=
