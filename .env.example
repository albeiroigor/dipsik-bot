# Required
DISCORD_TOKEN=
DEEPSEEK_API_KEY=

# Optional — defaults shown
DEEPSEEK_MODEL=deepseek-chat
PREFIX=!
TEMPERATURE=0.8
MAX_HISTORY=24

# "auto" lets the bot search the web when it needs to (requires the `ddgs`
# package). Any of no/off/0/false disables it.
WEB_SEARCH=auto

# Comma-separated channel IDs where the bot replies to every message
# without needing a mention, e.g. 123456789012345678,987654321098765432
OPEN_CHANNELS=

# If set, slash commands sync instantly to this server instead of globally
GUILD_ID=

# IANA timezone for daily tips, e.g. America/Bogota. Defaults to the
# server's local time if left empty.
TIMEZONE=

# Optional: seed an initial daily-tip schedule (a later /daily_tip
# command in that channel takes priority)
DAILY_TIP_CHANNEL=
DAILY_TIP_TIME=
